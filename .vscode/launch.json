{
    // ROS2 节点调试配置(以 attach 为主)。
    // 前提 1: C++ 包已用 RelWithDebInfo 重编,如
    //   colcon build --packages-select elfin_basic_api --cmake-args -DCMAKE_BUILD_TYPE=RelWithDebInfo
    // 前提 2: attach 普通用户进程需放开 ptrace 限制(重启失效,仅调试期使用):
    //   echo 0 | sudo tee /proc/sys/kernel/yama/ptrace_scope
    // 前提 3: attach root 进程(ros2_control_node,由 sudo chrt 10 启动)需要
    //   scripts/gdb_sudo.sh + 免密 sudo gdb,见 tasks.json "setup: allow sudo gdb (one-time)"。
    // 注:EtherCAT 初始化跑不通时 ros2_control_node 的周期线程尚未运行,
    //   此时 attach/暂停不会触发从站看门狗;初始化成功跑起来后再暂停硬件进程仍有风险。
    "version": "0.2.0",
    "configurations": [
        {
            // Python GUI: 需先用 ELFIN_GUI_DEBUG=1 启动 elfin_gui.py（脚本内 debugpy.listen(5678)）
            // 未设该环境变量时脚本无任何调试开销，正常跑。
            "name": "attach: elfin_gui (python)",
            "type": "debugpy",
            "request": "attach",
            "connect": { "host": "127.0.0.1", "port": 5678 },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/elfin_ws/src/elfin_robot/elfin_basic_api/scripts",
                    "remoteRoot": "/home/fit/cos_ws/elfin_ws/install/elfin_basic_api/lib/elfin_basic_api"
                }
            ],
            "justMyCode": false
        },
        {
            "name": "attach: elfin_driver",
            "type":"cppdbg",
            "request": "attach",
            "connect": {"host": "127.0.0.1", "port": 5678 },
            "pathMappings":
            [{
                "localRoot":"",
                "remoteRoot":""
            }]
        },
        {
            // F5 后弹出进程列表，输入 elfin_basic 过滤，回车即 attach
            "name": "attach: elfin_basic_api (c++)",
            "type": "cppdbg",
            "request": "attach",
            "program": "/home/fit/cos_ws/elfin_ws/install/elfin_basic_api/lib/elfin_basic_api/elfin_basic_api_node",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set pagination off" }
            ]
        },
        {
            "name": "attach: move_group (c++)",
            "type": "cppdbg",
            "request": "attach",
            "program": "/opt/ros/foxy/lib/moveit_ros_move_group/move_group",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set pagination off" }
            ]
        },
        {
            // 真机硬件层:直接 attach ros2_control_node(root 进程,经 scripts/gdb_sudo.sh 提权)。
            // 前置(见 tasks.json):
            //   1. (仅首次)任务 "setup: allow sudo gdb (one-time)"
            //   2. 任务 "build: ethercat debug (RelWithDebInfo)" 并重启硬件
            //   3. 任务 "hardware: elfin5_moveit (root, chrt 10)"
            //   4. 本配置按 F5,进程列表输入 ros2_control 过滤,回车即 attach
            // 断点:elfin_ethercat_driver/src/elfin_ethercat_manager.cpp:362
            //   即 "Failed to read from ret:0, slave_no:5, index:0x7001" 的打印点;
            //   readSDO 是模板函数,按 file:line 下断可命中所有实例化。
            "name": "attach: ros2_control_node (c++, root)",
            "type": "cppdbg",
            "request": "attach",
            "program": "/opt/ros/foxy/lib/controller_manager/ros2_control_node",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/home/fit/cos_ws/scripts/gdb_sudo.sh",
            "additionalSOLibSearchPath": "/home/fit/cos_ws/elfin_ws/install/elfin_ros_control/lib/elfin_ros_control;/home/fit/cos_ws/elfin_ws/build/elfin_ethercat_driver;/home/fit/cos_ws/elfin_ws/install/elfin_robot_msgs/lib",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set pagination off" }
            ]
        }
    ],
    "compounds": [
        {
            // 一键同时 attach GUI 与 basic_api
            "name": "attach: gui + basic_api",
            "configurations": [
                "attach: elfin_gui (python)",
                "attach: elfin_basic_api (c++)"
            ],
            "stopAll": false
        }
    ]
}
